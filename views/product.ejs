<!-- ============================================================
     product.ejs: page for a single product (e.g. /product/1)
     Receives one "product" from server.js
     ============================================================ -->
<!DOCTYPE html>
<html lang="en">

<!-- ---------- 1. HEAD: page settings (not visible on the page) ---------- -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Browser tab title shows the product name -->
    <title><%= product.name %> - Luscious Creativity</title>
    <!-- Link to the stylesheet in the public folder -->
    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <!-- ---------- 2. HEADER: logo, menu and search ---------- -->
    <header>
        <!-- Logo: clicking it goes to the homepage -->
        <a href="/" class="logo">
            <img src="/images/IMG-20261105-WA0010.jpg" alt="Luscious Creativity">
        </a>

        <!-- Navigation menu -->
        <nav id="nav-menu">
            <ul>
                <li><a href="/">Shop</a></li>
                <li><a href="/category/Fragrance">Fragrance</a></li>
                <li><a href="/category/Body Care">Body Care</a></li>
                <!-- Cart link with the number of items in it -->
                <li><a href="/cart">Cart (<%= cartCount %>)</a></li>
            </ul>
        </nav>

        <!-- Search box: sends the typed text to the /search route -->
        <form action="/search" method="GET">
            <input type="text" name="q" placeholder="Search...">
        </form>
    </header>

    <!-- ---------- 3. PRODUCT DETAILS: picture and information ---------- -->
    <section class="product-detail">

        <!-- Left side: product picture -->
        <div class="image-gallery">
            <img src="<%= product.image %>" alt="<%= product.name %>">
        </div>

        <!-- Right side: name, description, price and cart button -->
        <div class="product-info">
            <h3><%= product.name %></h3>
            <p><%= product.description %></p>
            <p>Ksh <%= product.price %></p>

            <!-- Add to Cart: sends this product's id to the /cart/add route -->
            <form action="/cart/add/<%= product.id %>" method="POST">
                <button type="submit">Add to Cart</button>
            </form>
        </div>
    </section>

    <!-- ---------- FOOTER: contact, social links and credits ---------- -->
 <footer>

    <!-- Brand name and short tagline -->
    <div class="footer-brand">
        <h4>Luscious Creativity</h4>
        <p>Thankyou for choosing us.</p>
    </div>

    <!-- Contact information -->
    <div class="footer-contact">
        <h4>Contact</h4>
        <p><i class="fa-solid fa-phone"></i> +254 182235214</p>
        <p><i class="fa-solid fa-envelope"></i> hello@yourbrand.com</p>
        <p><i class="fa-solid fa-location-dot"></i> Nairobi, Kenya</p>
    </div>

    <!-- Social media links: open in a new tab -->
    <div class="footer-social">
        <h4>Follow Us</h4>
        <a href="https://instagram.com/luscious_creativity" target="_blank" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href="https://facebook.com/YOUR_PAGE" target="_blank" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
        <a href="https://tiktok.com/@YOUR_HANDLE" target="_blank" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
        <a href="https://wa.me/254700000000" target="_blank" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
    </div>

    <!-- Fun credit line at the very bottom -->
    <div class="footer-credit">
        <p>© 2026 Luscious Creativity · Coded by an unserious human 😄</p>
    </div>

 </footer>

</body>
</html>
